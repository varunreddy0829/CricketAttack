# Raw Cricsheet match data used only by the offline ETL (compile_player_stats.py).
# Not needed at runtime -- the server only reads data/players_historical.json.
# ~104MB, excluded to keep the repo small and deploys fast.
data/All_Matches_Json/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Stale local debug logs
*.log

# Live-game crash/restart snapshot (per-machine runtime state, see
# _save_snapshot in src/server.py). Must never be committed or a deploy's
# `git pull` would clobber the VPS's in-flight games.
data/live_games.pkl
data/live_games.pkl.tmp

# Claude Code session/plan files (local tooling, not part of the app)
.claude/

# OS cruft
.DS_Store
Thumbs.db

data/ipl_json*.zip

# Scratch files from offline analysis runs -- not part of the build.
tmp/
